# 複製成 .env.local 後填入實際值（.env.local 已被 gitignore）

# Google AI Studio 金鑰（AQ. 前綴）
GEMINI_API_KEY=

# 選填：覆寫主要 Gemini model（預設 gemini-3.6-flash，失敗自動退回 gemini-3.5-flash-lite）
# GEMINI_MODEL=

# MongoDB 連線字串（Atlas 或本機），db 名稱建議 contract-checker
MONGODB_URI=

# Vercel Blob 讀寫 token
BLOB_READ_WRITE_TOKEN=

# 會員登入 JWT 簽章金鑰，用隨機字串，例如：
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
